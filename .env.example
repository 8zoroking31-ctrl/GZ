BOT_TOKEN=your_bot_token_here
CLIENT_ID=your_application_client_id_here
GUILD_ID=your_discord_server_id_here
# Optional override for default round interval (minutes)
# GUESS_INTERVAL_MINUTES=30
# Milliseconds to wait before the first scheduled round after setup (default 0)
# GUESS_FIRST_ROUND_DELAY_MS=0
# Set to 1 while testing to print the secret number in the bot console when a round starts
# GUESS_TEST_REVEAL_SECRET=1
# Seconds each round stays open (default 60)
# GUESS_ROUND_SECONDS=60
